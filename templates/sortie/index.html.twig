{% extends 'base.html.twig' %}

{% block title %}Sorties{% endblock %}

{% block body %}
<div class="container my-4">
    <h1>Sorties</h1>

    <form method="GET" class="mb-4">
        <div class="row">
            <div class="col-md-3">
                <label for="campus">Filtrer par Campus:</label>
                <select name="campus" id="campus" class="form-control">
                    <option value="">Tous les campus</option>
                    {% for c in campus %}
                        <option value="{{ c.id }}" {% if c.id|string == selectedCampusId %}selected{% endif %}>
                            {{ c.nom }}
                        </option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <button type="submit" class="btn btn-primary">Filtrer</button>
            </div>
        </div>
    </form>

    {% if sorties|length > 0 %}
        <div class="table-responsive">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Nom</th>
                        <th>Campus</th>
                        <th>Lieu</th>
                        <th>Date/Heure</th>
                        <th>État</th>
                    </tr>
                </thead>
                <tbody>
                    {% for sortie in sorties %}
                        <tr>
                            <td>{{ sortie.nom }}</td>
                            <td>{{ sortie.campus.nom }}</td>
                            <td>{{ sortie.lieu.nom }}</td>
                            <td>{{ sortie.dateHeureDebut|date('d/m/Y H:i') }}</td>
                            <td>{{ sortie.etat.value }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% else %}
        <div class="alert alert-info">
            Aucune sortie trouvée.
        </div>
    {% endif %}
</div>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}Créer une sortie{% endblock %}

{% block body %}
<div class="container my-4">
    <div class="card">
        <div class="card-header bg-info text-white">
            <h1 class="text-center"><strong>Créer une sortie</strong></h1>
        </div>
        <div class="card-body">
            {{ form_start(form) }}
            <div class="row mb-3">
                <div class="col-md-6">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        {{ form_label(form.nom, null, {'label_attr': {'style': 'min-width: 200px;'}}) }}
                        {{ form_widget(form.nom, {'attr': {'class': 'form-control', 'placeholder': 'Tapez le nom de la sortie'}}) }}
                    </div>
                    <div class="d-flex align-items-center gap-3 mb-3">
                        {{ form_label(form.dateHeureDebut, null, {'label_attr': {'style': 'min-width: 200px;'}}) }}
                        {{ form_widget(form.dateHeureDebut, {'attr': {'class': 'form-control'}}) }}
                    </div>
                    <div class="d-flex align-items-center gap-3 mb-3">
                        {{ form_label(form.dateLimiteInscription, null, {'label_attr': {'style': 'min-width: 200px;'}}) }}
                        {{ form_widget(form.dateLimiteInscription, {'attr': {'class': 'form-control'}}) }}
                    </div>
                    <div class="d-flex align-items-center gap-3 mb-3">
                        {{ form_label(form.nbInscriptionMax, null, {'label_attr': {'style': 'min-width: 200px;'}}) }}
                        {{ form_widget(form.nbInscriptionMax, {'attr': {'class': 'form-control', 'min': '0', 'max': '100'}}) }}
                    </div>
                    <div class="d-flex align-items-center gap-3">
                        {{ form_label(form.duree, null, {'label_attr': {'style': 'min-width: 200px;'}}) }}
                        {{ form_widget(form.duree, {'attr': {'class': 'form-control', 'min': '0', 'max': '1000'}}) }}
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        {{ form_label(form.campus, null, {'label_attr': {'style': 'min-width: 200px;'}}) }}
                        {{ form_widget(form.campus, {'attr': {'class': 'form-control'}}) }}
                    </div>
                    <div class="d-flex align-items-center gap-3 mb-3">
                        {{ form_label(form.lieu, null, {'label_attr': {'style': 'min-width: 200px;'}}) }}
                        {{ form_widget(form.lieu, {'attr': {'class': 'form-select'}}) }}
                    </div>
                </div>
            </div>

            <div class="input-group mb-5">
                {{ form_label(form.infosSortie) }}
                {{ form_widget(form.infosSortie, {'attr': {'class': 'form-control', 'rows': '8'}}) }}
            </div>
        <div class="d-flex justify-content-center gap-3">
            <button type="submit" class="btn btn-primary btn-lg">Enregistrer</button>
            <a href="{{ path('app_user') }}" class="btn btn-secondary btn-lg">Retour à la liste</a>
        </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}

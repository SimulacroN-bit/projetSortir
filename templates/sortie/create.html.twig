{% extends 'base.html.twig' %}

{% block title %}Créer une sortie{% endblock %}

{% block body %}
<div class="container my-4">
    <div class="card">
        <div class="card-header bg-info text-white">
            <h1 class="text-center"><strong>Créer une sortie</strong></h1>
        </div>
        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-6">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <p class="mb-0" style="min-width: 200px;"><strong>Nom de la sortie : </strong></p>
                        <input class="form-control" type="text" placeholder="Tapez le nom de la sortie" aria-label="sortie">
                    </div>
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <p class="mb-0" style="min-width: 200px;"><strong>Date et heure : </strong></p>
                        <input type="datetime-local" class="form-control" id="dateDebut" name="dateDebut" value="">
                    </div>
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <p class="mb-0" style="min-width: 200px;"><strong>Date limite : </strong></p>
                        <input type="date" class="form-control" id="dateLimite" name="dateLimite" value="">
                    </div>
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <p class="mb-0" style="min-width: 200px;"><strong>Nombre de places : </strong></p>
                        <input class="form-control" min="0" max="100" type="number" placeholder="Nombre de places" aria-label="nombrePlaces">
                    </div>
                    <div class="d-flex align-items-center gap-3">
                        <p class="mb-0" style="min-width: 200px;"><strong>Durée (minutes) : </strong></p>
                        <input min="0" max="1000" type="number" id="duree" class="form-control" />
                    </div>
                </div>

                <div class="col-md-6">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <p class="mb-0" style="min-width: 200px;"><strong>Campus : </strong></p>
                            <input class="form-control" type="text" placeholder="Adresse">
                            </div>
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <label for="lieu" class="mb-0" style="min-width: 200px;"><strong>Lieu :</strong></label>
                        <select id="lieu" name="lieu" class="form-select" aria-label="Choisis un lieu">
                            <option value="">Choisis un lieu</option>
                            {% for l in lieux %}
                                <option value="{{ l.id }}">{{ l.nom }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <p class="mb-0" style="min-width: 200px;"><strong>Rue : </strong></p>
                        <input class="form-control" type="text" placeholder="Adresse">
                    </div>
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <p class="mb-0" style="min-width: 200px;"><strong>Code postal : </strong></p>
                        <input class="form-control" type="text" placeholder="Code postal">
                    </div>
                    <div class="d-flex align-items-center gap-3">
                        <p class="mb-0" style="min-width: 200px;"><strong>Latitude / Longitude : </strong></p>
                        <input class="form-control" type="text" placeholder="48.8566, 2.3522">
                    </div>
                </div>
            </div>

            <div class="input-group mb-5">
                <p class="mb-0"><strong>Description et infos : </strong></p>
                <textarea class="form-control" rows="8" aria-label="With textarea"></textarea>
            </div>
        <div class="d-flex justify-content-center gap-3">
            <a href="{{ path('app_user') }}" class="btn btn-primary btn-lg">Enregistrer</a>
            <a href="{{ path('app_user') }}" class="btn btn-outline-secondary btn-lg">Publier</a>
            <a href="{{ path('app_user') }}" class="btn btn-secondary btn-lg">Retour à la liste</a>
        </div>
    </div>
</div>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}Créer une sortie{% endblock %}

{% block body %}
<div class="container my-4">
    <div class="card">
        <div class="card-header bg-info text-white">
            <h1 class="text-center"><strong>Créer une sortie</strong></h1>
        </div>
        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-6">
                    <div class="d-flex align-items-center gap-2">
                        <p><strong>Nom de la sortie : </strong></p>
                    <input class="form-control" type="text" placeholder="Tapez le nom de la sortie" aria-label="sortie">
                    </div>
                    <div class="d-flex align-items-center gap-2">
                    <p><strong>Date et heure de la sortie : </strong></p>
                        <label for="dateDebut" class="form-label mt-2"></label>
                        <input type="date" class="form-control" id="dateDebut" name="dateDebut" value="">
                    </div>
                    <div class="d-flex align-items-center gap-2">
                    <p><strong>Date limite d'inscription : </strong></p>
                        <label for="dateDebut" class="form-label mt-2"></label>
                        <input type="date" class="form-control" id="dateDebut" name="dateDebut" value="">
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <p><strong>Nombre de places : </strong></p>
                        <input class="form-control" type="text" aria-label="sortie">
                    </div>
                    <div data-mdb-input-init class="form-outline" style="width: 22rem;">
                        <label class="form-label" for="typeNumber"><strong>Durée (en minutes)</strong></label>
                        <input min="0" max="1000" type="number" id="typeNumber" class="form-control" />
                    </div>
                </div>

                <div class="col-md-6">
                    <p><strong>Campus : </strong></p>
                    <div class="d-flex align-items-center gap-2">
                        <label for="lieu" class="form-label mb-0"><strong>Lieu</strong></label>
                        <select id="lieu" name="lieu" class="form-select" aria-label="Choisis un lieu">
                            <option value="">Choisis un lieu</option>
                            {% for l in lieux %}
                                <option value="{{ l.id }}">{{ l.nom }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <p><strong>Rue : </strong></p>
                    <p><strong>Code postal : </strong></p>
                    <p><strong>Latitude / Longitude : </strong></p>
                </div>
            </div>

            <div class="input-group">
                <span class="input-group-text"><strong>Description et infos</strong></span>
                <textarea class="form-control" aria-label="With textarea"></textarea>
            </div>
        <div class="d-flex justify-content-center gap-3">
            <a href="{{ path('app_user') }}" class="btn btn-primary btn-lg">Enregistrer</a>
            <a href="{{ path('app_user') }}" class="btn btn-outline-secondary btn-lg">Publier</a>
            <a href="{{ path('app_user') }}" class="btn btn-secondary btn-lg">Retour à la liste</a>
        </div>
    </div>
</div>
{% endblock %}

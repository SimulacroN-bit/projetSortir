{% extends 'base.html.twig' %}

{% block title %}Mon profil | {{ parent() }}{% endblock %}

{% block stylesheets %}
    <style>
        .profil-form-label {
            font-weight: 500;
        }
    </style>
{% endblock %}

{% block body %}
    <div class="container mt-5">
        <div class="row justify-content-center align-items-start g-5">

            {# Colonne centrale : formulaire #}
            <div class="col-12 col-lg-5">
                <h2 class="text-center fw-bold mb-4">Mon profil</h2>

                {{ form_start(profilForm) }}
                <div class="row mb-3 align-items-center">
                    <label class="col-4 profil-form-label">Campus</label>
                    <div class="col-8">{{ form_widget(profilForm.campus, {'attr': {'class': 'form-select'}}) }}</div>
                </div>
                <div class="row mb-3 align-items-center">
                    <label class="col-4 profil-form-label">Pseudo</label>
                    <div class="col-8">{{ form_widget(profilForm.username, {'attr': {'class': 'form-control'}}) }}</div>
                </div>
                <div class="row mb-3 align-items-center">
                    <label class="col-4 profil-form-label">Prénom</label>
                    <div class="col-8">{{ form_widget(profilForm.prenom, {'attr': {'class': 'form-control'}}) }}</div>
                </div>
                <div class="row mb-3 align-items-center">
                    <label class="col-4 profil-form-label">Nom</label>
                    <div class="col-8">{{ form_widget(profilForm.nom, {'attr': {'class': 'form-control'}}) }}</div>
                </div>
                <div class="row mb-3 align-items-center">
                    <label class="col-4 profil-form-label">Téléphone</label>
                    <div class="col-8">{{ form_widget(profilForm.telephone, {'attr': {'class': 'form-control'}}) }}</div>
                </div>
                <div class="row mb-3 align-items-center">
                    <label class="col-4 profil-form-label">Email</label>
                    <div class="col-8">{{ form_widget(profilForm.mail, {'attr': {'class': 'form-control'}}) }}</div>
                </div>
                <div class="row mb-3 align-items-center">
                    <label class="col-4 profil-form-label">Mot de passe</label>
                    <div class="col-8">{{ form_widget(profilForm.plainPassword.first, {'attr': {'class': 'form-control'}}) }}</div>
                </div>
                <div class="row mb-3 align-items-center">
                    <label class="col-4 profil-form-label">Confirmation</label>
                    <div class="col-8">{{ form_widget(profilForm.plainPassword.second, {'attr': {'class': 'form-control'}}) }}</div>
                </div>

                {# Affiche les erreurs de validation (pseudo pris, mots de passe différents, etc.) #}
                {{ form_errors(profilForm.username) }}
                {{ form_errors(profilForm.plainPassword) }}

                <div class="text-center mt-4">
                    <button class="btn btn-outline-dark px-4">Enregistrer</button>
                </div>
                {{ form_end(profilForm) }}
            </div>

        </div>
    </div>
{% endblock %}
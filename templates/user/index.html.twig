{% extends 'base.html.twig' %}

{% block title %}Accueil{% endblock %}

{% block body %}
<style>

</style>

<div class="example-wrapper">
    {% if app.user %}
        <div class="text-center">
       <h1>Hello {{ app.user.username }} !</h1>
        </div>
    {% else %}
    <div class="text-center">
        <h1>Hello Invite !</h1>
    </div>
    {% endif %}
</div>

    <div class="card shadow-lg">
        <nav class="navbar navbar-light bg-light">
            <div class="container-fluid">
                <h4 class="mb-3">Filtrer les sorties</h4>
                <form class="w-100" method="GET">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <div class="d-flex align-items-center gap-2">
                                <label for="campus" class="form-label mb-0">Campus</label>
                                <select id="campus" name="campus" class="form-select" aria-label="Choisis un campus">
                                    <option value="">Choisis un campus</option>
                                    {% for c in campus %}
                                        <option value="{{ c.id }}" {% if filters.campusId == c.id %}selected{% endif %}>{{ c.nom }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                            <p class="mt-2">Le nom de la sortie contient</p>
                            <input class="form-control" type="search" name="nomSortie" placeholder="Search" aria-label="Search" value="{{ filters.nomSortie }}">
                            </div>
                            <div class="d-flex align-items-center gap-2">
                            <label for="dateDebut" class="form-label mt-2">Entre</label>
                            <input type="date" class="form-control" id="dateDebut" name="dateDebut" value="{{ filters.dateDebut }}">
                            </div>
                            <div class="d-flex align-items-center gap-2">
                            <label for="dateFin" class="form-label mt-2">et</label>
                            <input type="date" class="form-control" id="dateFin" name="dateFin" value="{{ filters.dateFin }}">
                            </div>
                        </div>

                        <div class="col-md-4 align-items-center">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="organisateur" value="1" id="flexCheckDefault1">
                                <label class="form-check-label" for="flexCheckDefault1">
                                    Sorties dont je suis l'organisateur/rice
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="inscrit" value="1" id="flexCheckDefault2">
                                <label class="form-check-label" for="flexCheckDefault2">
                                    Sorties auxquelles je suis inscrit/e
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="nonInscrit" value="1" id="flexCheckDefault3">
                                <label class="form-check-label" for="flexCheckDefault3">
                                    Sorties auxquelles je ne suis pas inscrit/e
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="termine" value="1" id="flexCheckDefault4">
                                <label class="form-check-label" for="flexCheckDefault4">
                                    Sorties terminées
                                </label>
                            </div>
                        </div>

                        <div class="col-md-4 d-flex align-items-center">
                            <button class="btn btn-outline-success w-100" type="submit">Rechercher</button>
                        </div>
                    </div>
                </form>
            </div>
        </nav>
    </div>
        <div class="card shadow-lg">
        <table class="table">
            <thead class="thead-dark">
            <tr>
                <th scope="col">Nom de la sortie</th>
                <th scope="col">Date de la sortie</th>
                <th scope="col">Clôture</th>
                <th scope="col">Inscrits/Places</th>
                <th scope="col">Etat</th>
                <th scope="col">Inscrit</th>
                <th scope="col">Organisateur</th>
                <th scope="col">Actions</th>
            </tr>
            </thead>
            <tbody>
            {% for sortie in sorties %}
            <tr>
                <td>{{ sortie.nom }}</td>
                <td>{{ sortie.dateHeureDebut|date('d/m/Y H:i') }}</td>
                <td>{{ sortie.dateLimiteInscription|date('d/m/Y') }}</td>
                <td>{{ sortie.participants|length }}/{{ sortie.nbInscriptionMax }}</td>
                <td>{{ sortie.etat.value }}</td>
                <td>
                    {% if app.user and sortie.participants.contains(app.user) %}
                        X
                    {% endif %}
                </td>
                <td>
                    <a href="{{ path('participant_detail', {'id': sortie.organisateur.id}) }}" class="text-decoration-none">
                        {{ sortie.organisateur.prenom }} {{ sortie.organisateur.nom }}
                    </a>
                </td>
                <td>
                    <a href="{{ path('app_sortie_detail', {'id': sortie.id}) }}" class="btn btn-sm btn-outline-primary">Afficher</a>
                </td>
            </tr>
            {% endfor %}
            </tbody>
        </table>
        </div>
        <div>
            <a href="{{ path('app_sortie_create') }}" class="btn btn-lg btn-outline-secondary">Créer une sortie</a>
    </div>
{% endblock %}
